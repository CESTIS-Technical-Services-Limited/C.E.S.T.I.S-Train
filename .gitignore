.claude/

# User Login — this repository is PUBLIC, so real user credential exports must
# never be committed here. Only the documented structure (README + template) is
# tracked; any real per-user folder created by a local export stays local.
/User Login/*
!/User Login/README.md
!/User Login/_TEMPLATE/
!/User Login/_TEMPLATE/**

# Offline System — the https certificate this computer makes for itself, and
# its private key. Per-machine and secret: never commit them.
/cert/
/Offline System/cert/

# Local tooling only (Playwright for driving the pages in a browser).
/node_modules/

# Bootstrap staging — the migration CLI's checkpoint/staging directory. During
# a REAL run it contains actual student and financial data; this repository is
# public, so it must never be committed.
/megadata-bootstrap-staging/

# Migration working files on the operator machine — the fetched sources are
# REAL student/financial data and the URL file is per-site; this repository
# is public, so none of it may ever be committed.
/megadata-sources/
/megadata-broker-url.txt
