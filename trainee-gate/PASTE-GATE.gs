  var room = gateSharedFile(G, gateCfg(G).roomsId, 'room.' + roomId + '.json', 'rm:' + roomId);
  if (!room || room.format !== G.gate.FORMAT.room || Number(room.version) > G.gate.VERSION) return { ok: false, error: 'not-ready', retry: true };
