  if (gateBusy(G)) return { ok: false, error: 'busy', retry: true };
  var held = gateCacheJson(G, 'n:' + nonce);
  G.cache.remove('n:' + nonce);
  if (!held || held.l !== gatePwLogin(acct)) return { ok: false, error: 'bad-nonce' };
  var e = s.entry;
