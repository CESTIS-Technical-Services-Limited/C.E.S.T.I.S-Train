  var hit = gateCacheJson(G, GATE_PW.CACHE);
  if (hit && typeof hit === 'object') return hit;
  var p = {};
  try { p = JSON.parse(G.props.getProperty(GATE_PW.PROP) || '{}') || {}; } catch (e) { p = {}; }
  gateCachePut(G, GATE_PW.CACHE, p, 600);
  return p;
}
