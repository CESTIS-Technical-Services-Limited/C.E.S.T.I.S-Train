   account), and it says nothing of where anything is kept. */
var GATE_MAIL = { QUEUE: 'MAIL_QUEUE', MAILED: 'MAILED', WINDOW_MS: 14 * 86400000, KEEP_MS: 30 * 86400000, PER_CALL: 5 };
