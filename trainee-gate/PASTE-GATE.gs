    try {
      var folder = gateTraineeFolder(G, a, idx.a[a]);
      var file = folder ? gateNewest(folder.getFilesByName(GATE_NAMES.inbox + '.' + x.lane + '.json')) : null;
      var lane = file ? gateReadJsonFile(file) : null;
