  if (gateCount(G, 's:' + key, GATE_LIMITS.LOCK_S) > GATE_LIMITS.START_MAX) return { ok: false, error: 'locked', retryAfter: GATE_LIMITS.LOCK_S };
  var nonce = gateRandomHex(32);
