      return m;
    }
    function examForTrainee(ctx, e, t) {
      if (e.id == null || e.id === '' || e.status === 'draft' || e.status === 'cancelled') return false;
      return !!e.course && (e.course === t.course || ctx.same(e.course, t.course));
    }
    function stripKeys(q) {
