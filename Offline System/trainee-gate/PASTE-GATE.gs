      d.voctrain_classSessions = ctx.L.voctrain_classSessions.filter(function (cs) { return sameCourse(cs.course); }).map(function (cs) {
        var r = copy(cs);
        if (Array.isArray(r.attendees)) r.attendees = r.attendees.filter(function (x) {
