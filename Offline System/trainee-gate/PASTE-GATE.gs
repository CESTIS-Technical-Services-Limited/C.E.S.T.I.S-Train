        if (!Object.keys(tombstones.chatRooms).length) delete tombstones.chatRooms;
      }
      var profTombs = isObj(ctx.tombs.studentProfiles) ? ctx.tombs.studentProfiles : {};
      [t.acct, t.stu].forEach(function (k) {
