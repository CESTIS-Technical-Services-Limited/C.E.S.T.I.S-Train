      if (led && led.folder) gateWriteConfigFile(G, led.folder, ids);
    }
    if (allIds && led && /^[0-9a-f]{64}$/.test(merged.GK_SECRET || '')) set.GATE_SETUP_VERSION = merged.GATE_SETUP_VERSION = String(GATE_VERSION);
